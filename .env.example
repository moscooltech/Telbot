# Required: Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# --- LLM Providers (minimum one required; tried in this order as fallbacks) ---
# 1) UnoRouter (PRIMARY): OpenAI-compatible gateway with free GPT/DeepSeek/GLM
#    models. Create a free account at unorouter.com (no credit card) and copy
#    your key. When set, UnoRouter is tried FIRST (protects Groq's 1k/day quota).
UNOROUTER_API_KEY=your_unorouter_api_key_here
# Free models tried in order (first that responds wins). Update if a model retires.
UNOROUTER_MODELS=gpt-5.4:free,gpt-5.5:free,deepseek-v4-flash:free

# 2) Groq (free tier: gpt-oss-120b) — fast fallback.
GROQ_API_KEY=your_groq_api_key_here
# NOTE: Gemini IMAGE models have zero free-tier API quota (text is free, images
# are paid). Only used for images if you have a paid Gemini key.
GEMINI_API_KEY=your_gemini_api_key_here

# RECOMMENDED for photorealistic images: Cloudflare Workers AI (real SDXL).
# Free tier: 10,000 Neurons/day = ~300 images/day. Free Cloudflare account.
#   1. dash.cloudflare.com -> Workers & Pages -> copy "Account ID"
#   2. dash.cloudflare.com/profile/api-tokens -> Create Token ->
#      template "Run Cloudflare Workers AI models" -> copy token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

# Optional image-gen keys: without any, keyless Pollinations legacy is used
# (works but weak/cartoonish "sana" model)
POLLINATIONS_API_KEY=your_pollinations_api_key_here
BYTEZ_API_KEY=your_bytez_api_key_here

# Gemini image models (paid only, tried in order). 2.5-flash-image retires 2026-10-02.
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image
GEMINI_IMAGE_ASPECT=9:16

# --- Image styles / render modes (see README "Image Styles") ---
# A prompt (or a single scene description) may start with one inline directive -
# /illustration, /design, /decompose, /diagram, /poster or /photo - to render
# that image as art, a spec sheet, an exploded view, a schematic or a poster
# instead of a photorealistic photo. The mode table (style words + negative
# prompt + klein-anchor flag per mode) lives in config.py::IMAGE_MODES.
# false = only honour directives YOU type; the script LLM stops choosing modes.
ENABLE_LLM_IMAGE_MODES=true
# Photo-mode suffix/negative are still env-overridable; non-photo modes use
# IMAGE_NEGATIVE_CORE (defined in config.py) so labels/text are allowed.
# IMAGE_STYLE_SUFFIX=photorealistic, candid documentary photograph, natural skin texture, realistic lighting, shot on dslr, 35mm, shallow depth of field
# IMAGE_NEGATIVE_PROMPT=low quality, blurry, deformed, extra fingers, watermark, text, logo, oversaturated, cartoon, anime, 3d render, cgi, illustration, painting, drawing, plastic skin, waxy skin, smooth airbrushed skin, doll, toy

# TTS voice customization (edge-tts voice name, speech rate, volume)
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+5%
TTS_VOLUME=+0%

# Optional: offline Piper TTS fallback (requires installing piper + a .onnx voice model)
ENABLE_PIPER=false
PIPER_VOICE_PATH=

# Subtitle tuning
SUBTITLE_WORDS_PER_CHUNK=2
SUBTITLE_FONT_SIZE=54
SUBTITLE_MARGIN_V=210

# --- Content Series / Queue (see README “Content Series”) ---
# State lives in series/active.json. On Render's free tier the disk is
# EPHEMERAL: the queue + schedule are wiped on every redeploy/restart.
# Series scheduling + display use this timezone (IANA name).
SERIES_TIMEZONE=Africa/Lagos
# Background scheduler poll interval (seconds).
SERIES_SCHEDULER_TICK_SECONDS=120
# Hard cap on queued prompts (also limits /series generate).
SERIES_MAX_PROMPTS=50
# Upper bound for /series generate <N>.
SERIES_MAX_PROMPTS_PER_GENERATE=20

# --- Optional: Render Webhook URL (required for app.py webhook mode) ---
WEBHOOK_URL=
PORT=10000
