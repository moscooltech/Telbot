# Required: Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# LLM Providers (minimum one required, multiple recommended for fallbacks)
GROQ_API_KEY=your_groq_api_key_here
# NOTE: Gemini IMAGE models have zero free-tier API quota (text is free, images
# are paid). Only used for images if you have a paid Gemini key.
GEMINI_API_KEY=your_gemini_api_key_here

# RECOMMENDED for photorealistic images: Cloudflare Workers AI (real SDXL).
# Free tier: 10,000 Neurons/day = ~300 images/day. Free Cloudflare account.
#   1. dash.cloudflare.com -> Workers & Pages -> copy "Account ID"
#   2. dash.cloudflare.com/profile/api-tokens -> Create Token ->
#      template "Run Cloudflare Workers AI models" -> copy token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

# Optional image-gen keys: without any, keyless Pollinations legacy is used
# (works but weak/cartoonish "sana" model)
POLLINATIONS_API_KEY=your_pollinations_api_key_here
BYTEZ_API_KEY=your_bytez_api_key_here

# Gemini image models (paid only, tried in order). 2.5-flash-image retires 2026-10-02.
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image
GEMINI_IMAGE_ASPECT=9:16

# TTS voice customization (edge-tts voice name, speech rate, volume)
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+5%
TTS_VOLUME=+0%

# Optional: offline Piper TTS fallback (requires installing piper + a .onnx voice model)
ENABLE_PIPER=false
PIPER_VOICE_PATH=

# Subtitle tuning
SUBTITLE_WORDS_PER_CHUNK=2
SUBTITLE_FONT_SIZE=54
SUBTITLE_MARGIN_V=210

# Optional: Render Webhook URL (required for app.py webhook mode)
WEBHOOK_URL=
PORT=10000
